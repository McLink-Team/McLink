{
  "name": "@mclink/android",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "McLink Android 端：Capacitor 外壳 + 复用 client/src 的「暖纸台」渲染层",
  "scripts": {
    "build:web": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "sync": "vite build && cap sync android",
    "open": "cap open android",
    "apk": "node scripts/build-apk.mjs",
    "verify": "node scripts/check-mobile-design.mjs && vite build && node scripts/smoke-mobile.mjs",
    "verify:design": "node scripts/check-mobile-design.mjs",
    "verify:smoke": "node scripts/smoke-mobile.mjs",
    "verify:e2e": "node scripts/e2e-mobile.mjs",
    "verify:vpn": "node scripts/verify-vpn-plan.mjs && node scripts/verify-vpn-bridge.mjs && node scripts/verify-vpn-copy.mjs",
    "verify:vpn:plan": "node scripts/verify-vpn-plan.mjs",
    "verify:vpn:bridge": "node scripts/verify-vpn-bridge.mjs",
    "verify:vpn:copy": "node scripts/verify-vpn-copy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@mclink/shared": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
