# =============================================================================
# mclink 反向代理示例（nginx + Let's Encrypt）
#
# 放到 /etc/nginx/conf.d/mclink.conf 或 sites-available/mclink 并自行 enable。
#
# 申请证书（先让 80 端口可达，再执行；certbot 会自动改写本文件的 ssl 段）：
#   sudo apt-get install -y certbot python3-certbot-nginx
#   sudo certbot --nginx -d cnnic.link
#   # 仅签证书（不自动改配置）：
#   sudo certbot certonly --nginx -d cnnic.link
# 续期：certbot 自带 systemd timer（systemctl list-timers | grep certbot），
# 手动验证续期用 `sudo certbot renew --dry-run`。
#
# =============================================================================
# 「反向代理有时候会超时」先查这三件套（按被忽略的概率排序）
#   1) send_timeout 3600s —— **给客户端写响应**的超时，默认 60s。
#      下 87MB 安装包时客户端读得慢（或中途暂停），60s 一到 nginx 就掐连接；
#      proxy_read_timeout 管的是"等上游"，管不到这一段，所以只调大它是没用的。
#   2) proxy_connect_timeout 10s —— 默认 60s。主控在重启/发版窗口内不监听，
#      请求会先挂满 60s 再 502；调小让失败变快、也更容易在日志里看见。
#   3) proxy_read_timeout 3600s —— 管"等上游响应"（含 WS 空闲）。默认 60s。
# 另外两点容易踩：
#   * 本文件的 upstream 故意**不写** keepalive_timeout（用 nginx 默认 60s）：
#     主控的 keepAliveTimeout 是 65s（server/src/server.ts:111）。要是把它调到 ≥65s，
#     就会出现"nginx 复用了一条主控刚关掉的连接 → 间歇性 502"。
#   * location 里只要出现 add_header，**server 段的 add_header 会被全部丢掉**；
#     且不加 always 时，4xx/5xx 响应上不会带 HSTS。安全头一律写 server 段 + always。
# =============================================================================
# 为什么 WebSocket（/ws）必须单独配置？（约 6 行关键点）
#   1) WebSocket 握手是一次标准的 HTTP/1.1 GET + `Upgrade: websocket` 请求，
#      要求代理**原样透传** Upgrade / Connection 头，并且必须使用 HTTP/1.1。
#   2) nginx 默认（proxy_http_version 1.0）会剥掉 Upgrade 头，握手直接失败，
#      前端只能反复重连，表现为「实时状态一直不刷新」。
#   3) 连接一旦升级成功就会长期空闲，而 proxy_read_timeout 默认只有 60s，
#      会把空闲的 WS 连接当作超时切断 —— 必须调大到 3600s。
#   4) 平台自身的 WS 心跳是 30 秒一次 ping，3600s 留足了余量。
#   5) 若同时开启 proxy_buffering，会让升级响应被缓冲，务必 keep 关闭。
#   6) 注意：EasyTier 的中继端口（默认 11010 TCP+UDP）是**裸 TCP/UDP**，
#      不经过这里；反代它需要 nginx 的 stream 模块（见文件末尾注释）。
# =============================================================================

upstream mclink_master {
    server 127.0.0.1:8787;
    keepalive 32;
}

# HTTP → HTTPS 跳转（certbot 申请的 http-01 校验也走这里）
server {
    listen 80;
    listen [::]:80;
    server_name cnnic.link;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cnnic.link;

    ssl_certificate     /etc/letsencrypt/live/cnnic.link/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cnnic.link/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 客户端安装包可能有几十 MB，放宽到 2G；下载走的是流式转发
    client_max_body_size 2048m;

    # 通用代理头
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 主控用 X-Forwarded-For 识别真实 IP（MCLINK_TRUST_PROXY=true），限流与审计依赖它

    # ---------------------------------------------------------------- 前端与 API
    location / {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    # --------------------------------------------------- 子节点安装脚本与二进制
    location /agent/ {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # 子节点安装要顺带下一个 7–23MB 的 easytier 二进制：走 location / 的 120s 时，
        # 慢线路上会超时成 HTTP 504，安装脚本随即报「返回了非 JSON 响应」这类怪错。
        proxy_buffering off;
        proxy_read_timeout 3600s;
        # 7–23MB 的二进制发给子节点：**发往客户端这一侧的超时是 send_timeout**，
        # 默认 60s 会在"对方读得慢"时把连接掐掉（安装脚本随即报非 JSON 响应）。
        send_timeout 3600s;
        proxy_connect_timeout 10s;
    }

    location /api/ {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # 登录/注册是低频接口，按 IP 限流（主控自身也有滑动窗口限流，这里是第一道）。
    # **只挂在这两个精确路径上**：以前挂在 location /api/ 上，等于给"某个 IP 的全部
    # API 调用"限 30 请求/分 —— 客户端在房间里固定 8 请求/分（心跳 10s + 房间详情 30s），
    # 控制台广播页运行中是 2s 一次轮询（30 请求/分），一张页面就能把配额吃满；
    # 家里/宿舍/网吧一个出口 IP 几台设备同时用，就会莫名其妙收到 503。
    location = /api/v1/auth/login {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        limit_req zone=mclink_login burst=10 nodelay;
    }

    location = /api/v1/auth/register {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        limit_req zone=mclink_login burst=10 nodelay;
    }

    # ---------------------------------------------------------------- WebSocket
    location /ws {
        proxy_pass http://mclink_master;
        # 1) 必须 1.1 才能 Upgrade
        proxy_http_version 1.1;
        # 2) 透传升级头（Connection 必须显式写成 upgrade）
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        # 3) 空闲连接不能被 60s 默认超时切断
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        # 4) 升级响应不能被缓冲
        proxy_buffering off;
        # 5) WS 握手请求很小，超时给短一点即可
        proxy_connect_timeout 10s;
    }

    # ---------------------------------------------------------------- 客户端下载
    location /downloads/ {
        proxy_pass http://mclink_master;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # 断点续传（主控已支持 Range）
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        # 87MB 的包发给慢客户端：默认 send_timeout 60s 会在客户端读得慢
        # 或中途暂停时把连接掐掉（表现就是"下载有时候失败/反代超时"）。
        send_timeout 3600s;
        proxy_connect_timeout 10s;
    }
}

# 登录接口限流区（放在 http {} 上下文；若本文件被 include 进 http 段则无需改动）
limit_req_zone $binary_remote_addr zone=mclink_login:10m rate=30r/m;

# =============================================================================
# 变体：只想要**一个** location（宝塔 / 1Panel 那种模板改起来最省事）
#
# 单个 location 也能跑全站（网页 + API + /ws + 下载），关键是这几个值：
#   1) proxy_pass 写死 127.0.0.1:8787 —— 没有 upstream 块就不能用名字；
#      **千万别走公网 IP**：同机反代时那是绕出去再绕回来（云厂商 NAT/hairpin、安全组、
#      conntrack 都会在这条路上咬人，表现就是间歇性的
#      `upstream timed out (110) while connecting to upstream`）。
#   2) Connection 用 $http_connection —— 不要用 $connection_upgrade：
#      后者要靠 map 定义，没有 map 时 nginx 会因为"未定义变量"直接起不来。
#      WS 握手时浏览器发的就是 Connection: Upgrade，原样透传即可；
#      HTTP/2 请求没有这个头（值为空），正好让 nginx 对上游走 keep-alive。
#   3) proxy_connect_timeout 5s —— 默认 60s。主控在重启/发版窗口不监听时，
#      请求会先挂满 60 秒再报错；调小让客户端立刻失败并重试。
#   4) send_timeout 3600s —— **发往客户端**那一侧的超时（默认 60s）。
#      下 87MB 安装包时客户端读得慢/中途暂停会被掐断，proxy_read_timeout 管不到它。
#   5) proxy_buffering off + read/send 3600s —— WS 与几十 MB 的下载都要。
#
# 为什么超时给到 3600s 也不会"卡一小时"：主控自己会在 MCLINK_REQUEST_DEADLINE_MS
# （默认 110s）主动回一个 JSON 504，客户端拿到的是结构化错误而不是干等。
#
# location ^~ / {
#     proxy_pass http://127.0.0.1:8787;
#     proxy_http_version 1.1;
#     proxy_set_header Host              $host;
#     proxy_set_header X-Real-IP         $remote_addr;
#     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     proxy_set_header Upgrade           $http_upgrade;
#     proxy_set_header Connection        $http_connection;
#
#     proxy_connect_timeout 5s;
#     proxy_read_timeout 3600s;
#     proxy_send_timeout 3600s;
#     send_timeout 3600s;
#     proxy_buffering off;
#     client_max_body_size 2048m;
# }
#
# 单个 location 的取舍：没有 upstream keepalive 连接池（每个请求开一条到主控的连接，
# 本地回环很便宜，不值得为它引入 upstream 块）；登录限流也得另配 location，
# 不做的话登录接口就只剩主控自身那道 240/分/IP 的限流。
# =============================================================================

# =============================================================================
# 如果需要通过反代暴露 EasyTier 中继端口（默认 11010，TCP+UDP 都要），
# 用 stream 模块而不是 http 模块（同一端口同时代理 TCP 与 UDP 需要两个 listen）：
#
# stream {
#     upstream mclink_relay_tcp { server 127.0.0.1:11010; }
#     upstream mclink_relay_udp { server 127.0.0.1:11010; }
#     server { listen 11010;       proxy_pass mclink_relay_tcp; proxy_timeout 600s; }
#     server { listen 11010 udp;   proxy_pass mclink_relay_udp; proxy_timeout 600s; }
# }
#
# 注意：
#   * 中继是长连接隧道，proxy_timeout 要放大，且不要启用任何 7 层解析；
#   * 更简单的做法是让主控直接监听 11010，不经过 nginx（少一跳，UDP 也更稳）；
#   * 一定要在安全组/ufw 放行 11010 的 TCP **和** UDP，否则客户端只能建 TCP 隧道。
# =============================================================================
